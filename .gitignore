# VSCode directories
.vscode/

# Node.js modules (if you're using Node.js)
node_modules/

# Dependency directories
bower_components/

# Python virtual environment directories (if you're using Python)
*.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Compiled files
*.class
*.log

# VSCode workspace configuration (specific to your editor, should not be shared)
.vscode/*

# VSCode Settings (user-specific, should not be tracked)
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json

# MacOS specific files
.DS_Store

# Windows specific files
Thumbs.db

# JetBrains IDEs (e.g., IntelliJ, PyCharm, etc.)
.idea/

# Exclude test output and coverage reports
coverage/

# Exclude build artifacts
dist/
build/
out/

# Ignore archive files
*.tar.gz
*.zip
*.tar.bz2

# Ignore log files
*.log

# Ignore temporary files created by text editors
*~

